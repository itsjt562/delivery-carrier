<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shippo_view_delivery_carrier_form_inherit" model="ir.ui.view">
        <field name="name">shippo.view.delivery.carrier.form.inherit</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position="before">
                <page
                    string="Shippo Configuration"
                    name="shippo_configuration"
                    invisible="delivery_type != 'shippo'"
                >
                    <group>
                        <group>
                            <field
                                name="shippo_test_api_key"
                                required="delivery_type == 'shippo'"
                            />
                            <field name="shippo_label_file_type" />
                            <field name="shippo_service_level_token" />
                            <field name="shippo_default_package_type_id" />
                        </group>
                        <group>
                            <field
                                name="shippo_production_api_key"
                                required="delivery_type == 'shippo'"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
